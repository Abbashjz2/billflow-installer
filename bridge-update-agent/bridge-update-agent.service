[Unit]
Description=Bridge Update Agent
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bridge-update-agent
EnvironmentFile=/opt/billflow-bridge/.env
Environment=UPDATE_AGENT_HOST=0.0.0.0
ExecStart=/usr/bin/node /opt/bridge-update-agent/server.js
Restart=always
RestartSec=5


[Install]
WantedBy=multi-user.target
