[Unit]
Description=Bridge Update Agent
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=__UPDATE_AGENT_DIR__
EnvironmentFile=__BRIDGE_DIR__/.env
Environment=UPDATE_AGENT_HOST=0.0.0.0
Environment=UPDATE_SCRIPT=__UPDATE_AGENT_DIR__/update-bridge.sh
ExecStart=/usr/bin/node __UPDATE_AGENT_DIR__/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target